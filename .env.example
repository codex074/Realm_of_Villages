REALM_DATABASE_URL=postgresql+psycopg://realm:realm@db:5432/realm

# --- โหมดหลายผู้เล่น (ดู docs/MULTIPLAYER.md) ---
# เปิดระบบบัญชี: ผู้เล่นต้องสมัคร/เข้าสู่ระบบ, บัญชีแรกเป็นผู้ดูแล (admin)
# REALM_AUTH_REQUIRED=true
# อายุ session (ชั่วโมง) ค่าเริ่มต้น 336 = 14 วัน
# REALM_SESSION_TTL_HOURS=336
# เปิดเมื่อเข้าผ่าน HTTPS เท่านั้น (คุกกี้จะมี flag Secure)
# REALM_COOKIE_SECURE=true
# จำกัดคำสั่งที่เปลี่ยนสถานะต่อบัญชี/IP ต่อ 10 วินาที
# REALM_RATE_LIMIT_PER_10S=60
